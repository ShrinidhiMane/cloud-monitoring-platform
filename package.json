{
  "name": "aws-monitoring-workspace",
  "version": "1.0.0",
  "description": "\"Workspace for Team 5 Project\"",
  "keywords": [
    "\"aws\"",
    "\"monitoring\""
  ],
  "homepage": "https://github.com/kb019/AWS-Monitoring-Android-App#readme",
  "bugs": {
    "url": "https://github.com/kb019/AWS-Monitoring-Android-App/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kb019/AWS-Monitoring-Android-App.git"
  },
  "license": "ISC",
  "author": "Team5",
  "type": "module",
  "workspaces": [
    "packages/api-client"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:api": "npm run lint --workspace=./packages/api-client",
    "lint:webapp": "npm run lint --prefix ./apps/web",
    "lint:server": "npm run lint --prefix ./aws/backend",
    "lint": "npm run lint:api && npm run lint:webapp && npm run lint:server && npm run lint:mobile",
    "lint:mobile": "npm run lint --prefix ./apps/mobile",
    "lint:fix-web": "npm run lint:fix --prefix ./apps/web",
    "lint:fix-mobile": "npm run lint:fix --prefix ./apps/mobile",
    "lint:fix-api":"npm run lint:fix --workspace=./packages/api-client",
    "lint:fix-server":"npm run lint:fix --prefix ./aws/backend",
    "lint:fix-all":"npm run lint:fix-web && npm run lint:fix-mobile && npm run lint:fix-api && npm run lint:fix-server",
    "install:dep": "npm install && npm run install:web && npm run install:mobile",
    "install:mobile": "npm install --prefix ./apps/mobile",
    "install:server":"npm install --prefix ./aws/backend",
    "setup": "npm run install:dep && npm run build --prefix ./packages/api-client && npm run install:server",
    "install:web": "npm install --prefix ./apps/web",
    "web:dev": "npm run dev --prefix ./apps/web",
    "api-client:dev": "npm run dev --prefix ./packages/api-client",
    "mobile:dev":"npm run start --prefix ./apps/mobile",
    "dev:client": "concurrently --kill-others \"npm run api-client:dev\" \"npm run web:dev\"",
    "dev:mobile": "concurrently --raw --kill-others \"npm run api-client:dev\" \"npm run mobile:dev\"",
    "start:server":"npm run start --prefix ./aws/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "@eslint/js": "^10.0.1"
  }
}
