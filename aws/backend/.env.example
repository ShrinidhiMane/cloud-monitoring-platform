# Local backend AWS credential placeholders for testing only.
# This file is a scaffold and is not auto-loaded by the backend runtime.
# Use it as a local reference, or copy values into an actual local `.env`
# and source them in your shell before starting the backend.

AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ALLOWED_INSTANCE_IDS=
